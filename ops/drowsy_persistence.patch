+def _publish_closed_file(temporary_path, final_path):
+    """Publish a fully written file without replacing an existing event."""
+    with open(temporary_path, "rb") as source:
+        os.fsync(source.fileno())
+    os.link(temporary_path, final_path)
+    os.unlink(temporary_path)
+    directory_fd = os.open(os.path.dirname(final_path), os.O_RDONLY | os.O_DIRECTORY)
+    try:
+        os.fsync(directory_fd)
+    finally:
+        os.close(directory_fd)
+
+
+def _write_final_bytes(final_path, content):
+    os.makedirs(os.path.dirname(final_path), exist_ok=True)
+    temporary_path = final_path + ".partial"
+    with open(temporary_path, "xb") as output:
+        output.write(content)
+        output.flush()
+        os.fsync(output.fileno())
+    _publish_closed_file(temporary_path, final_path)
+
+
+def _finish_video(writer, temporary_path, final_path):
+    writer.release()
+    capture = cv2.VideoCapture(temporary_path)
+    valid = capture.isOpened() and capture.read()[0]
+    capture.release()
+    if not valid:
+        raise RuntimeError(f"Video incompleto preservado: {temporary_path}")
+    _publish_closed_file(temporary_path, final_path)
+
+
+def _free_bytes(directory):
+    filesystem = os.statvfs(directory)
+    return filesystem.f_bavail * filesystem.f_frsize
+
